# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# --- MLflow backend store (Postgres) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# --- MLflow artifact store (SeaweedFS, S3-compatible) ---
# SeaweedFS runs with S3 auth disabled in this local stack, but boto3 refuses to
# sign a request without credentials, so these are sent and ignored. A real
# deployment turns on S3 auth and these become real.
MINIO_ROOT_USER=credit-risk
MINIO_ROOT_PASSWORD=change-me-too
MLFLOW_BUCKET=mlflow

# --- Model served by the API ---
MODEL_NAME=credit-risk
MODEL_STAGE=Production
# The API serves models:/MODEL_NAME@champion and falls back to the version in
# MODEL_STAGE when no version carries the alias (a registry from before
# aliases); /health reports which one it used as model_ref. Registration
# promotes a candidate only if its held-out PR-AUC is at most
# PROMOTION_PR_AUC_TOLERANCE below the champion's; otherwise it becomes the
# challenger (Staging) until `python -m credit_risk.models.registry
# set-champion --version N`. Both are read by the registry CLI and
# scripts/verify_deploy.py; docker-compose.yml does not pass them into the
# containers, so the API and the DAG use the defaults shown here.
# MODEL_ALIAS=champion
# PROMOTION_PR_AUC_TOLERANCE=0.005

# --- Decision policy ---
# base | group_aware_equalized_odds
THRESHOLD_POLICY=base
# registry: decide at the threshold_at_k tag of the loaded model version (the
#           10%-capacity cutoff); a version without the tag uses
#           DECISION_THRESHOLD and /health reports threshold_source "fallback".
# env:      always decide at DECISION_THRESHOLD.
THRESHOLD_SOURCE=registry
DECISION_THRESHOLD=0.5

# --- Optional: Alertmanager -> Telegram ---
# Leave empty to disable. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# On Linux set this to the output of `id -u`. Leave as-is on macOS.
UID_GID=0:0
AIRFLOW_UID=50000
