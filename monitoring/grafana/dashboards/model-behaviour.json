          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credit-prometheus"
          },
          "expr": "ALERTS{alertstate=~\"firing|pending\"}",
          "editorMode": "code",
          "range": false,
          "instant": true,
