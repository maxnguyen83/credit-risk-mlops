  "description": "Is the system treating protected groups differently? The failure with no operational symptoms.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Selection-rate gap (max − min)",
      "description": "Demographic parity difference computed live over served traffic. The pipeline gates new models at 0.05; FairnessGapExceeded fires when production breaches the same number for 15 minutes. Only groups holding at least 30 of the 200 rolling window slots are included — a rate measured on a handful of requests is 0.0 or 1.0 and would clear the gate on sample size alone.",
      "datasource": {
        "type": "prometheus",
        "uid": "credit-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credit-prometheus"
          },
          "expr": "max(credit_selection_rate) - min(credit_selection_rate)",
          "editorMode": "code",
          "range": true
        }
      ]
    },
