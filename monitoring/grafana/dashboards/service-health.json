    {
      "id": 8,
      "type": "timeseries",
      "title": "/predict latency — p50 / p95 / p99",
      "description": "Quantiles from the histogram buckets, not an average: the average is the one statistic guaranteed to hide the tail this SLO is written about. Dashed line is the 100ms p95 target that SlowPredictions alerts on.",
      "datasource": {
        "type": "prometheus",
        "uid": "credit-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "gradientMode": "opacity",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
