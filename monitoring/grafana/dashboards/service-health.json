        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credit-prometheus"
          },
          "expr": "sum(rate(credit_errors_total[$__rate_interval]))\n  /\n(sum(rate(credit_errors_total[$__rate_interval])) + sum(rate(credit_predictions_total[$__rate_interval])))",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
