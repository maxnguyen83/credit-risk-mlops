    {
      "id": 2,
      "type": "stat",
      "title": "Distance from this model's own baseline",
      "description": "Live high-risk share minus credit_baseline_high_risk_share, the rate THIS model flagged on its evaluation set. Not the 22.12% default rate: 22% of accounts do default, but the model puts far fewer than that on the intervention list at its cutoff, so measuring against prevalence would show a permanent 10-point gap on a model behaving exactly as registered. NaN until the API has scored 50 requests since it started, and meaningless until the baseline is installed at model load. HighRiskShareShift fires when this stays above 0.10 for 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "credit-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
