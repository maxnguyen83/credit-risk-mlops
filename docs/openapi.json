{
  "openapi": "3.1.0",
  "info": {
    "title": "Credit Default Early-Warning API",
    "description": "Early-warning scoring for an existing credit-card portfolio. Ranks accounts for the monthly intervention list; it does not approve or decline anyone, and a human makes the final call on every account it flags.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health, plus which model is answering",
        "description": "Report the served model, not merely that the port is open.\n\nReturns 200 even when degraded, on purpose: a 503 here puts the container\ninto a restart loop that destroys the very logs explaining the problem.\n`credit_model_loaded == 0` and the ModelNotLoaded alert are what wake\nsomeone up; this endpoint's job is to say why.\n\nIt also says which cutoff decisions are made at and where it came from.\n`threshold_source: \"fallback\"` is a working service deciding at a configured\nconstant because the loaded version carries no threshold tag.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Prometheus exposition",
        "description": "Hand the registry straight to Prometheus.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "What is deployed right now",
        "description": "API build and model build in one place, for incident reviews.",
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predict": {
      "post": {
        "tags": [
          "inference"
        ],
        "summary": "Score one account for default next month",
        "description": "Score a single account and return the decision with its policy.",
        "operationId": "predict_api_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditApplication"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "The record did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; see request_id in the logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No model is loaded; the service is degraded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predict/batch": {
      "post": {
        "tags": [
          "inference"
        ],
        "summary": "Score a portfolio slice in one call",
        "description": "Score up to `max_batch_size` accounts; the nightly core-banking path.",
        "operationId": "predict_batch_api_v1_predict_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchPredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchPredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "The record did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; see request_id in the logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No model is loaded; the service is degraded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
