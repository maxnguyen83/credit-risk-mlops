          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error ratio (5m)",
      "description": "Errors over all terminal requests. Target < 1%; HighErrorRate fires at 5%. No traffic gives 0/0, which reads as no data rather than as a 0% error rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "credit-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
