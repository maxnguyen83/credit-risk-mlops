          "expr": "histogram_quantile(\n  0.95,\n  sum by (le) (\n    rate(credit_prediction_latency_seconds_bucket{endpoint=~\".*predict\"}[$__rate_interval])\n  )\n)",
          "editorMode": "code",
          "range": true,
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "credit-prometheus"
          },
          "expr": "histogram_quantile(\n  0.99,\n  sum by (le) (\n    rate(credit_prediction_latency_seconds_bucket{endpoint=~\".*predict\"}[$__rate_interval])\n  )\n)",
          "editorMode": "code",
          "range": true,
          "legendFormat": "p99"
        }
      ]
    },
