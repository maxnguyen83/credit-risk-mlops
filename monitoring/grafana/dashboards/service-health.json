        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credit-prometheus"
          },
          "expr": "histogram_quantile(\n  0.50,\n  sum by (le) (\n    rate(credit_prediction_latency_seconds_bucket{endpoint=~\".*predict\"}[$__rate_interval])\n  )\n)",
          "editorMode": "code",
          "range": true,
          "legendFormat": "p50"
