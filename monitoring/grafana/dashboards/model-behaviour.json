    {
      "id": 1,
      "type": "stat",
      "title": "High-risk share (rolling)",
      "description": "Share of the last 200 scored requests at or above the decision threshold. Compare against credit_baseline_high_risk_share, not against the 22.12% default rate — the first is what the model flags, the second is what actually defaults. Deliberately uncoloured: whether this number is good depends on the baseline, so the colour lives on the next panel, which makes the same comparison HighRiskShareShift makes (0.05 / 0.10). NaN until the API has scored 50 requests since it started.",
      "datasource": {
        "type": "prometheus",
        "uid": "credit-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
